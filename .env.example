# Supabase — create a project at https://supabase.com, then copy values here into .env
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=           # public, ships in the frontend; RLS-gated read-only
SUPABASE_SERVICE_ROLE_KEY=   # SECRET — server/loaders/agents only, never in frontend

# Database direct connection (for loaders / migrations)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Agent swarm (Phase 0b+)
ANTHROPIC_API_KEY=
BRAVE_API_KEY=               # Brave Search, $3/1k — chosen over SerpAPI in Path B
